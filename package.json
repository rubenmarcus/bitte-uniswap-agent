{
  "name": "bitte-uniswap-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx src/server.ts\" \"make-agent dev\"",
    "dev-testnet": "concurrently \"pnpm run src/server.ts\" \"make-agent dev -t\"",
    "build": "tsc",
    "start": "pnpm run src/server.ts",
    "serve": "pnpm run src/server.ts",
    "lint": "eslint '{src,tests}/**/*.{js,jsx,ts,tsx}'",
    "fmt": "eslint --fix '{src,tests}/**/*.{js,jsx,ts,tsx}' && prettier --write '{src,tests}/**/*.{js,jsx,ts,tsx}'",
    "test": "jest --config jest.config.ts"
  },
  "dependencies": {
    "@bitte-ai/agent-sdk": "^0.1.8",
    "@uniswap/sdk-core": "^6.1.0",
    "@uniswap/smart-order-router": "^4.8.6",
    "cors": "^2.8.5",
    "ethers": "^5.7.2",
    "express": "^4.21.2",
    "near-safe": "^0.9.4",
    "swagger-ui-express": "^5.0.1",
    "viem": "^2.21.54",
    "zerion-sdk": "^0.0.13"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.5.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "make-agent": "^0.2.3",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
